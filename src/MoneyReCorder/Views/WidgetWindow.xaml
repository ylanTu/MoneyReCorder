<Window x:Class="MoneyReCorder.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MoneyReCorder.ViewModels"
        xmlns:converters="clr-namespace:MoneyReCorder.Converters"
        mc:Ignorable="d"
        Title="MoneyReCorder Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        Opacity="{Binding WidgetOpacity, Mode=OneWay}"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringFallbackConverter x:Key="IconFallback" />
    </Window.Resources>

    <Grid x:Name="RootGrid">

        <!-- 右键菜单：三种形态下都可用 -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开主窗口" Command="{Binding OpenMainWindowCommand}" />
                <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="悬浮窗形态">
                    <MenuItem Header="小球（悬停展开）"
                              IsCheckable="True"
                              IsChecked="{Binding IsBallMode, Mode=OneWay}"
                              Command="{Binding SetModeCommand}"
                              CommandParameter="Ball" />
                    <MenuItem Header="胶囊（悬停展开）"
                              IsCheckable="True"
                              IsChecked="{Binding IsCapsuleMode, Mode=OneWay}"
                              Command="{Binding SetModeCommand}"
                              CommandParameter="Capsule" />
                    <MenuItem Header="完整卡片"
                              IsCheckable="True"
                              IsChecked="{Binding IsCardMode, Mode=OneWay}"
                              Command="{Binding SetModeCommand}"
                              CommandParameter="Card" />
                </MenuItem>
                <Separator />
                <MenuItem Header="锁定 / 解除锁定位置" Command="{Binding ToggleLockCommand}" />
                <MenuItem Header="切换置顶" Command="{Binding ToggleTopmostCommand}" />
                <Separator />
                <MenuItem Header="隐藏小组件" Command="{Binding HideWidgetCommand}" />
                <MenuItem Header="退出 MoneyReCorder" Command="{Binding ExitAppCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- ═══════════ 形态一：小球（默认） ═══════════ -->
        <Grid Margin="6" Visibility="{Binding ShowBall, Converter={StaticResource BoolToVis}}">
            <Border Width="56" Height="56" CornerRadius="28"
                    BorderThickness="1" BorderBrush="#38FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.30" Color="#000000" />
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💰" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CompactBalance}"
                               FontSize="9.5" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ 形态二：胶囊 ═══════════ -->
        <Border Margin="6" Height="40" CornerRadius="20" Padding="14,0"
                BorderThickness="1" BorderBrush="#38FFFFFF"
                Visibility="{Binding ShowCapsule, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.30" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💰" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalBalanceDisplay}"
                           FontSize="13" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════ 形态三：完整卡片（也是悬停展开后的样子） ═══════════ -->
        <Grid x:Name="CardHost" Margin="6" Width="280"
              Visibility="{Binding ShowCard, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="14"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- 标题行 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text=" 我的钱包" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- 锁定位置 -->
                            <Button Style="{StaticResource WidgetIconButtonStyle}"
                                    Command="{Binding ToggleLockCommand}"
                                    ToolTip="锁定位置（防止误拖动）">
                                <TextBlock FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔓" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Text" Value="🔒" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- 打开主窗口 -->
                            <Button Style="{StaticResource WidgetIconButtonStyle}"
                                    Command="{Binding OpenMainWindowCommand}"
                                    ToolTip="打开主窗口">
                                <TextBlock Text="📂" FontSize="11" />
                            </Button>

                            <!-- 打开设置 -->
                            <Button Style="{StaticResource WidgetIconButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip="打开设置（双击浮窗同样可以）">
                                <TextBlock Text="⚙️" FontSize="11" />
                            </Button>

                            <!-- 更多 -->
                            <Button Style="{StaticResource WidgetIconButtonStyle}"
                                    Click="OpenMenu_Click"
                                    ToolTip="更多操作">
                                <TextBlock Text="⋯" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 总资产 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="总资产" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalBalanceDisplay}"
                                   FontSize="25" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 账户列表 -->
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4"
                                        Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon, Converter={StaticResource IconFallback}, ConverterParameter=🏦}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Balance, StringFormat={}¥{0:N2}}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 操作提示 -->
                    <TextBlock Text="悬停展开 · 双击进设置 · 拖动移动"
                               FontSize="10" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
