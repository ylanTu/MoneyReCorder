<UserControl x:Class="MoneyReCorder.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MoneyReCorder.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="32,24,32,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="316" />
                </Grid.ColumnDefinitions>

                <!-- ═══════════════ 左：皮肤 · 主题色 · 浮窗行为 ═══════════════ -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <!-- 皮肤 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="皮肤" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="整套配色方案，点选即应用"
                                               FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        CornerRadius="10" Padding="10,4">
                                    <TextBlock Text="{Binding CurrentSkinName}" FontSize="12"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                            </Grid>

                            <ListBox ItemsSource="{Binding Presets}"
                                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Card" Width="120" CornerRadius="10"
                                                            Padding="5"
                                                            Background="{DynamicResource BgPrimaryBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1.5">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding Description}">
                                            <Border Height="40" CornerRadius="7" Padding="5"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                                <Border CornerRadius="5" Padding="6,5"
                                                        Background="{Binding CardBrush}">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding AccentBrush}" />
                                                            <Border Height="3" Width="26" CornerRadius="1.5"
                                                                    Margin="5,0,0,0" VerticalAlignment="Center"
                                                                    Background="{Binding TextBrush}" Opacity="0.85" />
                                                        </StackPanel>
                                                        <Border Height="3" Width="42" CornerRadius="1.5"
                                                                Margin="0,5,0,0" HorizontalAlignment="Left"
                                                                Background="{Binding TextBrush}" Opacity="0.3" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="深色模式" FontSize="13" />
                                    <TextBlock Text="在成对的深 / 浅皮肤之间切换"
                                               FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 主题色 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="主题色" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="在当前皮肤上微调强调色，用于按钮、金额等"
                                               FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="10" Padding="10,4"
                                        Background="{Binding AccentColor}">
                                    <TextBlock Text="{Binding AccentColor}" FontSize="11"
                                               Foreground="White" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                                Background="{Binding}"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetAccentColorCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 悬浮窗形态 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="悬浮窗形态" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="默认小球：鼠标悬停展开详情，双击直接进入设置"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <RadioButton GroupName="WidgetMode"
                                             Style="{StaticResource ModeOptionStyle}"
                                             Tag="小球"
                                             ToolTip="贴在桌面上的一颗小圆球，鼠标移上去才展开金额明细"
                                             IsChecked="{Binding IsModeBall, Mode=TwoWay}">
                                    <Ellipse Width="26" Height="26">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </RadioButton>

                                <RadioButton GroupName="WidgetMode"
                                             Style="{StaticResource ModeOptionStyle}"
                                             Tag="胶囊"
                                             ToolTip="横向小长条，直接显示总资产，悬停展开明细"
                                             IsChecked="{Binding IsModeCapsule, Mode=TwoWay}">
                                    <Border Width="46" Height="18" CornerRadius="9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </RadioButton>

                                <RadioButton GroupName="WidgetMode"
                                             Style="{StaticResource ModeOptionStyle}"
                                             Tag="完整卡片"
                                             Margin="0"
                                             ToolTip="始终展开的卡片，信息最全但占用桌面空间"
                                             IsChecked="{Binding IsModeCard, Mode=TwoWay}">
                                    <Border Width="30" Height="24" CornerRadius="5" Padding="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Height="2.5" CornerRadius="1.25" Background="#CCFFFFFF" />
                                            <Border Height="2.5" CornerRadius="1.25" Background="#66FFFFFF"
                                                    Margin="0,3,10,0" />
                                        </StackPanel>
                                    </Border>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 桌面浮窗 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="桌面浮窗" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="控制悬浮组件是否显示、是否压在其它窗口之上"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="显示桌面小组件" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="桌面上的小球 / 胶囊，双击可进设置" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ShowWidget, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding CanShowPet}">
                                <StackPanel>
                                    <TextBlock Text="显示桌宠" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="需要 Spine 骨骼资源，当前版本不可用"
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ShowPet, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="小组件始终置顶" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="关闭后不会遮挡其它窗口（推荐关闭）"
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding WidgetTopmost, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="桌宠始终置顶" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="关闭后随窗口层级自然排列"
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding PetTopmost, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="打开主窗口时自动隐藏浮窗"
                                               Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="用主窗口时浮窗自动让位，关闭后恢复"
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoHideFloatingWindows, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════ 右：预览 · 透明度 ═══════════════ -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="实时预览" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="小组件在当前皮肤与透明度下的效果"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Border Height="178" CornerRadius="12" Margin="0,12,0,0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource PrimaryLightColor}" Offset="0" />
                                        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <Border Width="200" CornerRadius="12" Padding="13"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Opacity="{Binding WidgetOpacity}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                              Opacity="0.18" Color="#000000" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💰" FontSize="12" />
                                                <TextBlock Text=" 我的钱包" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="总资产" FontSize="10" Margin="0,9,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="¥12,345.67" FontSize="19" FontWeight="Bold"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                            <Border Height="1" Margin="0,8,0,6"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <Grid>
                                                <TextBlock Text="🏦 招商银行" FontSize="10" />
                                                <TextBlock Text="¥8,000.00" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 收起状态的小球：示意悬停展开 -->
                                    <Ellipse Width="34" Height="34"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,12,12" Opacity="{Binding WidgetOpacity}">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Opacity="0.28" Color="#000000" />
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <TextBlock Text="悬停展开 · 双击进设置"
                                               FontSize="10" Margin="10,0,0,8"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="窗口透明度" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="拖动即时预览，数值越低越通透"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="小组件" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource AppSliderStyle}"
                                        Minimum="0.2" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding WidgetOpacity, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding WidgetOpacity, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主窗口" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource AppSliderStyle}"
                                        Minimum="0.6" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding MainWindowOpacity, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding MainWindowOpacity, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="桌宠" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource AppSliderStyle}"
                                        Minimum="0.2" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding PetOpacity, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding PetOpacity, StringFormat={}{0:P0}}" />
                            </Grid>

                            <TextBlock Text="托盘图标可随时显示浮窗或打开主窗口，把浮窗全部隐藏也不会失联。"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 常驻状态栏：设置即时生效，状态与恢复默认始终可见 -->
        <Border Grid.Row="1" Padding="32,10"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Content="↩ 恢复默认外观"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding ResetToDefaultCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
