<UserControl x:Class="MoneyReCorder.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MoneyReCorder.ViewModels"
             xmlns:converters="clr-namespace:MoneyReCorder.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <UserControl.Resources>
        <converters:AmountDisplayConverter x:Key="AmountConverter" />
        <converters:AccountTypeToStringConverter x:Key="AccountTypeConverter" />
        <converters:TransactionTypeToColorConverter x:Key="TransTypeColorConverter" />
        <converters:TransactionTypeToSymbolConverter x:Key="TransTypeSymbolConverter" />
    </UserControl.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel>
            <!-- ===== 概览卡片 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 总资产 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="总资产" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalBalanceDisplay}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="所有账户合计" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 本月收入 -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="本月收入" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MonthlyIncomeDisplay}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource IncomeBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="当前月份" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 本月支出 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="本月支出" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MonthlyExpenseDisplay}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="当前月份" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 账户列表 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="💳 我的账户" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,4"
                                        Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon, FallbackValue='🏦'}"
                                                   FontSize="20" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Type, Converter={StaticResource AccountTypeConverter}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Balance, StringFormat={}¥{0:N2}}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 最近交易 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="📝 最近交易" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding RecentTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,4"
                                        Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TransTypeSymbolConverter}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{Binding Type, Converter={StaticResource TransTypeColorConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Description, TargetNullValue='未备注'}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TransactionDate, StringFormat={}{0:MM/dd}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Amount, StringFormat={}{0:N2}}"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
