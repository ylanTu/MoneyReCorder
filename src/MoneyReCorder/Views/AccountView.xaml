<UserControl x:Class="MoneyReCorder.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MoneyReCorder.ViewModels"
             xmlns:models="clr-namespace:MoneyReCorder.Models"
             xmlns:converters="clr-namespace:MoneyReCorder.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AccountViewModel}">

    <UserControl.Resources>
        <converters:AccountTypeToStringConverter x:Key="AccountTypeConverter" />
        <converters:AmountDisplayConverter x:Key="AmountConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel>
            <!-- 页面标题 + 添加按钮 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💳 账户管理"
                           FontSize="20" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="+ 添加账户"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ToggleAddFormCommand}" />
            </Grid>

            <!-- 错误提示 -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,12" />

            <!-- 添加账户表单 -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="新建账户" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="账户名称"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding NewAccountName}"
                                 Style="{StaticResource TextBoxStyle}"
                                 Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="账户类型"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  SelectedValue="{Binding NewAccountType}"
                                  Margin="0,0,0,8" Padding="8">
                            <ComboBox.Items>
                                <ComboBoxItem Content="银行卡" />
                                <ComboBoxItem Content="信用卡" />
                                <ComboBoxItem Content="微信" />
                                <ComboBoxItem Content="支付宝" />
                                <ComboBoxItem Content="现金" />
                                <ComboBoxItem Content="其他" />
                            </ComboBox.Items>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="当前余额"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding NewBalanceText}"
                                 Style="{StaticResource TextBoxStyle}"
                                 Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="卡号后4位"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding NewLastFourDigits}"
                                 Style="{StaticResource TextBoxStyle}"
                                 MaxLength="4" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="4" Grid.Column="1"
                                    Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddAccountCommand}" />
                            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleAddFormCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 账户列表 -->
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <Border Grid.Column="0" Width="44" Height="44"
                                        CornerRadius="22"
                                        Background="{DynamicResource PrimaryLightBrush}">
                                    <TextBlock Text="{Binding Icon, FallbackValue='🏦'}"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 信息 -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type, Converter={StaticResource AccountTypeConverter}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- 余额 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Balance, StringFormat={}¥{0:N2}}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0" />

                                <!-- 小组件开关 -->
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding ShowInWidget}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          ToolTip="桌面小组件显示" />

                                <!-- 删除按钮 -->
                                <Button Grid.Column="4" Content="🗑"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="18" Cursor="Hand"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.DeleteAccountCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
